# -- Required ------------------------------------------------------------------
# PostgreSQL password (used by all services)
DB_PASSWORD=changeme_strong_password

# Postgres DSN the controller connects with.
DATABASE_URL=postgres://postgres:changeme_strong_password@postgres:5432/mdm_iac

# NanoMDM API key, use secure random: openssl rand -hex 32
NANOMDM_API_KEY=changeme_random_api_key

# JWT secret for the controller REST API (HS256 session tokens)
JWT_SECRET=changeme_long_random_secret

# Shared secret NanoMDM presents when calling controller webhook, again use secure random.
WEBHOOK_SECRET=changeme_webhook_secret

# Key for the body HMAC NanoMDM puts on every webhook call (-webhook-hmac-key).
# by default, the controller uses WEBHOOK_SECRET for this, but you can set a separate key if you so choose.
# WEBHOOK_HMAC_KEY=

# Encrypts step-ca's CA keys at rest. If you don't set this, step-ca will store its keys unencrypted.
STEPCA_PASSWORD=changeme_stepca_password

# Browser origins allowed to call the REST API directly (comma sep)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Credentials to create the first admin user on first boot
# Alternatively:
#   docker compose -f docker-compose.prod.yml exec controller \
#     python -m controller.tenant_cli user add default jeff@example.com --role admin)
CONTROLLER_BOOTSTRAP_ADMIN_EMAIL=
CONTROLLER_BOOTSTRAP_ADMIN_PASSWORD=

# Public HTTPS URL for the controller API (used in enrollment profile, webhook URLs, etc.)
PUBLIC_API_URL=

# Public hostname for the MDM/enrollment endpoints
MDM_HOSTNAME=

# APNs topic for MDM push cert
MDM_TOPIC=

# Optional overrides. By default, they are derived MDM_HOSTNAME:
#   MDM_SERVER_URL  defaults to https://${MDM_HOSTNAME}/mdm
#   SCEP_URL        defaults to https://${MDM_HOSTNAME}/scep/${SCEP_NAME}
# These implicitly assume :443
MDM_SERVER_URL=
SCEP_URL=
SCEP_NAME=mdm_device_scep

# Optional path to a CA cert bundle to embed in enrollment profile
# MDM_EMBED_CA_CERT_PATH=/stepca/certs/root_ca.crt

# SCEP provisioner challenge, again another secure random shared secret.
SCEP_CHALLENGE=changeme_scep_challenge

# The enrollment profile's MDM ServerURL carries ?tenant=<id>&tsig=<hmac>. As the device is calling the server, it
# could edit its own ServerURL to another tenant, so the controller checks the tsig against the tenant's secret.
# This is completely irrelevant for a single tenant instance.
MDM_ALLOW_UNSIGNED_TENANT_CLAIM=false
# refuse a check-in from an ALREADY-KNOWN device that carries no tenant+tsig at all.
# allow_unsigned takes precident over require_signed
MDM_REQUIRE_SIGNED_TENANT_CLAIM=false

# Block enrolling unknown serials from DEP syncs
MDM_ENROLL_REQUIRE_KNOWN_SERIAL=false

# APNs push certificate as a base64 of the PEM files
# `./setup.sh push-cert` uploads the certificate to MicroMDM directly, and should be preferred.
PUSH_CERT_PEM_B64=
PUSH_KEY_PEM_B64=

# S3 storage for app storage. Optional if you aren't using that feature or configure per tenant
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=
# For non-AWS S3 endpoints
AWS_S3_ENDPOINT_URL=
# Default limit for tenant app storage, in bytes because we love pointless math. Optional, can be configured per tenant.
MDM_DEFAULT_STORAGE_QUOTA_BYTES=

# Optional if you want to separate controller DB and NanoMDM DB. If unset, the controller uses DATABASE_URL for both.
# NANOMDM_DATABASE_URL=postgres://user:pass@host:5432/nanomdm

# Key to encrypt sensitive values at rest.
# This should be a urlsafe-base64 32-byte Fernet key, generate with:
# `python -c 'import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())'`
SECRET_ENCRYPTION_KEY=
# ^ While the key can be left unset, it is derived from JWT_SECRET which prevents them from being rotated separately.
# setup.sh env fills this in, so only a hand-written .env reaches the derived key.

# Time between DEP syncs. Default is 60 to avoid getting rate limited by Apple.
DEP_SYNC_INTERVAL_MINUTES=60

DEP_ADE_REQUIRE_APPLE_SIGNATURE=true

# PEM bundle of extra Apple anchor certs
# DEP_APPLE_ANCHOR_CERTS=/path/to/apple-anchors.pem

# For using a separate HMAC key for DDM instead of the WEBHOOK_SECRET.
# DDM_HMAC_SECRET=

SYNC_INTERVAL_MINUTES=5
# Time to wait for a controller to respond to a sync request
# MDM_CONTROLLER_SYNC_STALL_SECONDS=1200
NANOMDM_DEBUG=false
# Tortoise/asyncpg pool limits per controller process
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_SIZE=2
# Limit on concurrent tasks during a reconsile
MDM_MAX_CONCURRENT_TASKS=25
# How often to sweep for device retention
RETENTION_INTERVAL_HOURS=24
TASK_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=90
FLOW_RUN_RETENTION_DAYS=30

# How long to keep audit log entries. 0 means "forever" (default).
AUDIT_LOG_RETENTION_DAYS=0
AUDIT_LOG_SIZE_WARNING_ROWS=100000

# After an app or profile install fails, the controller will retry after this amount of minutes, then increases the wait
# time after each subsequent failure for that specific device, up to the max below of 24 hours.
MDM_COMMAND_RETRY_MINUTES=30
MDM_COMMAND_RETRY_MAX_MINUTES=1440
# How long until an unconfirmed install is considered a failure and when to trigger a retry.
MDM_APP_CONFIRM_MINUTES=60
# How often the controller will poll for unconfirmed installs
APP_CONFIRM_POLL_MINUTES=5
# Alert webhooks block prviate IPs by default
DISPATCHER_WEBHOOK_PRIVATE_ALLOWLIST=
