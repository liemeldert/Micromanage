# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL password (used by all services)
DB_PASSWORD=changeme_strong_password

# NanoMDM API key -- any random string, used for controller ↔ nanomdm auth
NANOMDM_API_KEY=changeme_random_api_key

# JWT secret for the controller REST API (HS256 session tokens)
JWT_SECRET=changeme_long_random_secret

# Shared secret NanoMDM presents when calling the controller webhook
WEBHOOK_SECRET=changeme_webhook_secret

# Browser origins allowed to call the REST API directly (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: seed a first admin on startup (otherwise provision via the CLI:
#   docker compose exec controller python -m controller.tenant_cli user add default you@example.com --role admin)
CONTROLLER_BOOTSTRAP_ADMIN_EMAIL=
CONTROLLER_BOOTSTRAP_ADMIN_PASSWORD=

# Public HTTPS URL that enrolled devices can reach (must be your real domain/IP)
PUBLIC_API_URL=https://mdm.example.com

# Public hostname for the MDM/enrollment endpoints (enrollment profile + step-ca SANs)
MDM_HOSTNAME=mdm.example.com

# ── Device enrollment (auto-generated enrollment profile) ─────────────────────
# APNs push topic from your MDM push certificate (e.g. com.apple.mgmt.External.<uuid>)
MDM_TOPIC=
# Optional overrides -- sensible defaults are derived from MDM_HOSTNAME:
#   MDM_SERVER_URL  defaults to https://${MDM_HOSTNAME}/mdm
#   SCEP_URL        defaults to https://${MDM_HOSTNAME}/scep/${SCEP_NAME}
MDM_SERVER_URL=
SCEP_URL=
SCEP_NAME=mdm_device_scep
# SCEP provisioner challenge (matches your step-ca SCEP provisioner config)
SCEP_CHALLENGE=

# ── Optional: S3 / object store for hosting app packages ──────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=
# For non-AWS S3 (MinIO, Cloudflare R2, etc.)
AWS_S3_ENDPOINT_URL=
AWS_S3_USE_SSL=true
AWS_S3_PATH_STYLE=false

# ── Automated Device Enrollment (ADE/DEP · Apple Business/School Manager) ─────
# DEP server tokens are decrypted and stored ENCRYPTED at rest in the controller
# database. The encryption key comes from SECRET_ENCRYPTION_KEY if set (a
# urlsafe-base64 32-byte Fernet key, e.g.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ), otherwise it is derived from JWT_SECRET. Set a dedicated key in production so
# DEP credentials can be re-keyed independently of session tokens.
# SECRET_ENCRYPTION_KEY=
# How often to pull newly-assigned devices from ABM/ASM (minutes).
DEP_SYNC_INTERVAL_MINUTES=60
# Advanced/testing: point the DEP client at a simulator instead of Apple.
#   DEP_BASE_URL=https://mdmenrollment.apple.com   (default)
# The device-facing ADE endpoint verifies the CMS signature on each device's
# MachineInfo against Apple's CA (services.dep_verify). It is ADVISORY by default
# (the result is logged/recorded; the endpoint is already gated by the per-tenant
# enrollment token baked into the DEP profile URL). Once you've confirmed real
# devices verify in staging, set this to reject unverified requests:
# DEP_ADE_REQUIRE_APPLE_SIGNATURE=false
# Optional: a PEM bundle of extra Apple anchor certs, if a device's identity cert
# chains to a root not in the shipped bundle (controller/data/apple_ca_anchors.pem).
# DEP_APPLE_ANCHOR_CERTS=/path/to/apple-anchors.pem

# ── Tuning ────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=5
NANOMDM_DEBUG=false
