# TLS front for step-ca. 9443 (published) serves one provisioner's SCEP path, and 8081 (internal) carries step-ca's
# challenge webhook to the controller. Everything else returns 404. Rendered to /etc/nginx/conf.d/default.conf with
# SCEP_NAME substituted.

ssl_certificate     /stepca-tls/scep-front.crt;
ssl_certificate_key /stepca-tls/scep-front.key;
ssl_protocols       TLSv1.2 TLSv1.3;
server_tokens       off;

# Docker's DNS, re-resolved per request, so a recreated upstream does not leave a stale address.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
    listen 8081 ssl;
    server_name _;
    client_max_body_size 64k;

    location = /webhook/scep-challenge {
        limit_except POST { deny all; }
        set $controller_upstream http://controller:8000;
        proxy_pass $controller_upstream/webhook/scep-challenge;
        # step-ca sets no deadline on this call, so a stuck controller becomes a 504, which step-ca reads as a deny.
        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }

    location / {
        return 404;
    }
}

server {
    listen 9443 ssl;
    server_name _;
    client_max_body_size 1m;

    location = /scep/${SCEP_NAME} {
        limit_except GET POST { deny all; }
        set $stepca_upstream https://step-ca:9000;
        proxy_pass $stepca_upstream/scep/${SCEP_NAME}$is_args$args;
        proxy_ssl_trusted_certificate /stepca-certs/root_ca.crt;
        proxy_ssl_verify on;
        # Leaf, intermediate and root; the default depth of 1 stops short of the root.
        proxy_ssl_verify_depth 2;
        proxy_ssl_server_name on;
        proxy_ssl_name step-ca;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }

    location / {
        return 404;
    }
}
