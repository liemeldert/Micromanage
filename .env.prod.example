# ── MicromanageIAC production environment ─────────────────────────────────────
# Paste these into Portainer's "Environment variables" for the stack (or attach
# this file as .env). Generate secrets with:  openssl rand -hex 32

# ── Required secrets ──────────────────────────────────────────────────────────
DB_PASSWORD=                      # PostgreSQL password
NANOMDM_API_KEY=                  # NanoMDM management API key (any long random string)
JWT_SECRET=                       # controller session-token signing secret
WEBHOOK_SECRET=                   # shared secret for the NanoMDM -> controller webhook
STEPCA_PASSWORD=                  # encrypts the step-ca CA keys at rest (set once, before first boot)

# ── Public addressing (must be reachable by your devices, over HTTPS) ─────────
# The controller, NanoMDM and step-ca serve device-facing endpoints. Apple requires
# HTTPS for all of them, so in production they sit behind a TLS-terminating reverse
# proxy (Traefik/Caddy/nginx) on your public hostname. Set these to the PUBLIC https
# URLs your proxy exposes (not the internal container ports).
MDM_HOSTNAME=mdm.example.com      # public hostname for the MDM/enrollment endpoints
PUBLIC_API_URL=https://mdm.example.com        # controller base URL devices use for
                                              # app manifests + enrollment download

# ── Images (override only if your ghcr repo path differs) ─────────────────────
CONTROLLER_IMAGE=ghcr.io/liemeldert/micromanage_2-controller:stable
WEBUI_IMAGE=ghcr.io/liemeldert/micromanage_2-webui:stable

# ── Host ports (change if they collide on your server) ────────────────────────
WEBUI_PORT=3000
CONTROLLER_PORT=8001
MDM_PORT=443
STEPCA_PORT=9443

# ── First-run admin (set on first deploy so you can log in; then blank + redeploy)
CONTROLLER_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
CONTROLLER_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
CONTROLLER_BOOTSTRAP_TENANT=default

# ── Enrollment / SCEP ─────────────────────────────────────────────────────────
# APNs push topic from your MDM push certificate (com.apple.mgmt.External.<uuid>)
MDM_TOPIC=
# Defaults are derived from MDM_HOSTNAME; override for non-standard ports/paths:
MDM_SERVER_URL=                   # default https://${MDM_HOSTNAME}/mdm
SCEP_URL=                         # e.g. https://${MDM_HOSTNAME}:9443/scep/mdm_device_scep
SCEP_NAME=mdm_device_scep
SCEP_CHALLENGE=                   # SCEP challenge -- step-ca auto-creates the provisioner with this on first boot
CORS_ALLOWED_ORIGINS=https://mdm.example.com

# ── APNs push certificate (base64 of the PEM files) ───────────────────────────
# Obtain the cert from Apple (mdmcert.download or identity.apple.com/pushcert),
# then:  base64 -w0 MDM_Certificate.pem   and   base64 -w0 push.key
# The apns-init one-shot uploads them to NanoMDM on deploy. Leave blank to skip.
PUSH_CERT_PEM_B64=
PUSH_KEY_PEM_B64=

# ── Optional: S3 / object store for hosting app packages ──────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=
AWS_S3_USE_SSL=true
AWS_S3_PATH_STYLE=false

# ── Tuning ────────────────────────────────────────────────────────────────────
SYNC_INTERVAL_MINUTES=5
NANOMDM_DEBUG=false
