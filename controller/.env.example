# Database
DB_PASSWORD=secure_password_here

# NanoMDM
NANOMDM_API_KEY=your_nanomdm_api_key_here
NANOMDM_DEBUG=false

# SCEP
SCEP_CHALLENGE=your_scep_challenge_here
SCEP_CA_PASS=your_ca_password_here

# Controller
SYNC_INTERVAL_MINUTES=5
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_DEFAULT_REGION=us-east-1

# CLI
CLI_KEY=your_secure_cli_key_here

# API
JWT_SECRET=your_jwt_secret_key_here

# Public URL for enrollment
PUBLIC_API_URL=https://mdm.example.com